{
  "name": "@memb/opencode-plugin",
  "version": "0.2.1",
  "type": "module",
  "description": "MemB persistent memory plugin for OpenCode — add, search, and manage memories across sessions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memb",
    "memory",
    "ai-memory",
    "persistent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/membai/memb",
    "directory": "integrations/memb-plugin/.opencode-plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "opencode-skills"
  ],
  "scripts": {
    "build": "bun build opencode-memb.ts --outdir dist --target bun --format esm --entry-naming index.[ext] && tsc --emitDeclarationOnly --outDir dist --declaration",
    "dev": "bun build opencode-memb.ts --outdir dist --target bun --format esm --entry-naming index.[ext] --watch",
    "type-check": "tsc --noEmit",
    "prepack": "bun run build",
    "postpack": ""
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "config",
      "chat.message",
      "tool.execute.before",
      "tool.execute.after",
      "experimental.chat.messages.transform",
      "experimental.session.compacting",
      "shell.env"
    ]
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162",
    "membai": "^3.0.8"
  },
  "devDependencies": {
    "bun-types": ">=1.3.14",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
